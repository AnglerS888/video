#!/bin/sh
# ============================================================
# pre-commit：前端源码有改动时自动 vite build，
# 并把产物 internal/web/static 一并加入本次提交。
#
# 为什么产物必须入库：
#   产物是 go:embed 的输入。Dockerfile 只拷 internal/，
#   容器内「立即更新」也只下载 Gitee 源码包后 go build，
#   两条部署路径都不会在服务器上构建前端。
#
# 跳过本次构建：
#   VDL_SKIP_WEB=1 git commit ...    或    git commit --no-verify
# ============================================================
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${VDL_SKIP_WEB:-0}" = "1" ]; then
    echo "[pre-commit] VDL_SKIP_WEB=1，跳过前端构建"
    exit 0
fi

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"

# 只在两种情况构建：产物缺失，或 web/ 下有暂存改动
need=0
reason=""
if [ ! -f internal/web/static/index.html ]; then
    need=1
    reason="前端产物缺失"
elif printf '%s\n' "$staged" | grep -q '^web/'; then
    need=1
    reason="前端源码有改动"
fi

if [ "$need" = "0" ]; then
    exit 0
fi

command -v npm >/dev/null 2>&1 || {
    echo "[pre-commit] 需要构建前端（$reason），但没找到 npm" >&2
    echo "[pre-commit] 装好 Node.js 后重试，或 git commit --no-verify 跳过本次构建" >&2
    exit 1
}

cd web

# 首次提交或依赖有变（package.json / lock）时先装依赖
if [ ! -d node_modules ] || printf '%s\n' "$staged" | grep -qE '^web/(package\.json|package-lock\.json)$'; then
    echo "[pre-commit] 安装前端依赖（npm install）..."
    npm install --registry=https://registry.npmmirror.com
fi

echo "[pre-commit] $reason，构建前端（vite build）..."
npm run build

cd "$ROOT"
git add -A internal/web/static
echo "[pre-commit] 已把 internal/web/static 的最新产物加入本次提交"
